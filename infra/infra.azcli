#!/bin/bash

# Builds a new hoverflylagoons.co.uk WordPress VM on Azure and restores the site
# from a fresh copy of the live database and files (saved in ../backup/)
# Does NOT touch DNS - check with ./compare-pages.sh then run ./switch-dns.sh

# run from WSL in the infra folder: ./infra.azcli

# The VM clones main from GitHub, so only deploy when everything is committed and pushed
if [ -n "$(git status --porcelain)" ]; then
  echo "Uncommitted changes - commit and push first"
  exit 1
fi

git fetch origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "Local HEAD is not the same as origin/main - push (or pull) first"
  exit 1
fi

if [ ! -f ../secrets/dnsimpletoken.txt ]; then
  echo "Need ../secrets/dnsimpletoken.txt for certbot"
  exit 1
fi

# copy the live database and files (WordPress core + wp-content) down to ../backup
# before creating anything - also serves as a local backup
live=dave@hoverflylagoons.co.uk
# ~/.ssh/config only maps the azure key to *.cloudapp.azure.com, so name it here
sshopts="-i ${HOME}/.ssh/id_rsa_azure -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
ts=$(date +%Y%m%d-%H%M%S)
livedb=../backup/live-db-${ts}.sql.gz
livefiles=../backup/live-files-${ts}.tgz
mkdir -p ../backup

if ! ssh ${sshopts} ${live} "set -o pipefail; sudo mysqldump --single-transaction wordpress | gzip" > ${livedb} \
   || ! gzip -t ${livedb}; then
  echo "Could not copy the live database - stopping"
  exit 1
fi

if ! ssh ${sshopts} ${live} "sudo tar czf - -C /var/www html" > ${livefiles} \
   || ! gzip -t ${livefiles}; then
  echo "Could not copy the live files - stopping"
  exit 1
fi

ls -lh ${livedb} ${livefiles}

set -x

# Ubuntu 26.04 LTS on Arm64 (the VM size below is Arm) - check with:
# az vm image list --publisher Canonical --offer ubuntu-26_04-lts --all --architecture Arm64 -o table
image=Canonical:ubuntu-26_04-lts:server-arm64:latest

# Generate a random suffix between 1 and 1000
int=$(shuf -i 1-1000 -n 1)

rgprefix=HoverflyLagoons
rg=${rgprefix}${int}

# Don't put capitals in dns name below and it needs to be unique (ie not used in azure at the moment)
dnsname=hoverflylagoons${int}

region=westeurope
vmname=${dnsname}vm
vnet=vnet${int}
subnet=subnet${int}
publicIPName=publicIP${int}
nsgname=nsg${int}
nicName=nic${int}

# resource group
az group create \
   --name ${rg} \
   --location ${region}

# virtual network
az network vnet create \
    --resource-group ${rg} \
    --name ${vnet} \
    --subnet-name ${subnet}

# network security group
az network nsg create \
    --resource-group ${rg} \
    --name ${nsgname}

az network nsg rule create \
    --resource-group ${rg} \
    --nsg-name ${nsgname} \
    --name nsgGroupRuleSSH22 \
    --protocol tcp \
    --priority 998 \
    --destination-port-range 22 \
    --access allow

az network nsg rule create \
    --resource-group ${rg} \
    --nsg-name ${nsgname} \
    --name nsgGroupRuleWeb80 \
    --protocol tcp \
    --priority 1001 \
    --destination-port-range 80 \
    --access allow

az network nsg rule create \
    --resource-group ${rg} \
    --nsg-name ${nsgname} \
    --name nsgGroupRuleWeb443 \
    --protocol tcp \
    --priority 1002 \
    --destination-port-range 443 \
    --access allow

# public IP (Standard sku is static) and associate with the given DNS name
az network public-ip create \
    --resource-group ${rg} \
    --name ${publicIPName} \
    --sku Standard \
    --zone 1 \
    --dns-name ${dnsname}

# nic and associate with vnet, publicip
az network nic create \
    --resource-group ${rg} \
    --name ${nicName} \
    --vnet-name ${vnet} \
    --subnet ${subnet} \
    --public-ip-address ${publicIPName} \
    --network-security-group ${nsgname}

# admin username defaults to my local username (dave)
az vm create \
    --resource-group ${rg} \
    --name ${vmname} \
    --location ${region} \
    --nics ${nicName} \
    --image ${image} \
    --ssh-key-values @~/.ssh/id_rsa_azure.pub \
    --storage-sku StandardSSD_LRS \
    --security-type Standard \
    --size Standard_B2pts_v2
    # B2pts_v2 doesn't support Trusted Launch, so the security type has to be Standard
    # West Europe pay-as-you-go prices Nov 2026. OS disk: Standard SSD E4 £1.80pm (Premium P4 was £4.37)
    # --size Standard_B2pts_v2 # £5.27pm (2 vCPU Arm, 1GB) - needs the swap and mysql tuning in create-webserver.sh
    # --size Standard_B2pls_v2 # £21.08pm (2 vCPU Arm, 4GB) - next step up if 1GB struggles
    # --size Standard_B1ms # £13.17pm (1 vCPU Intel, 2GB) - B-series v1, retires 15/11/2028, needs the x64 image

# copy the dnsimple token (for certbot DNS-01) and the live database and files to the VM
# create-webserver.sh moves the token into /etc/letsencrypt and deletes this copy
# I have seen scp timeout so retry until it works
host=dave@${dnsname}.westeurope.cloudapp.azure.com
n=0
until [ "$n" -ge 5 ]
do
   scp -o StrictHostKeyChecking=no ../secrets/dnsimpletoken.txt ${host}:/home/dave/ && break
   n=$((n+1))
   sleep 15
done

n=0
until [ "$n" -ge 5 ]
do
   scp -o StrictHostKeyChecking=no ${livedb} ${host}:/home/dave/live-db.sql.gz \
     && scp -o StrictHostKeyChecking=no ${livefiles} ${host}:/home/dave/live-files.tgz && break
   n=$((n+1))
   sleep 15
done

# installs nginx, php, mysql, certbot cert and restores the live database and files
az vm run-command invoke \
    -g ${rg} \
    -n ${vmname} \
    --command-id RunShellScript \
    --scripts @create-webserver.sh

set +x

# helper to ssh to this VM: ./sshCurrentVM.sh
echo "ssh -o StrictHostKeyChecking=no ${host}" > sshCurrentVM.sh
chmod +x sshCurrentVM.sh

echo ""
echo "Built ${rg}"
echo "ssh -o StrictHostKeyChecking=no ${host}"
echo "Next: ./compare-pages.sh ${int}"
echo "Then: ./switch-dns.sh ${int}"
